    { "t0": 1.6, "t1": 5.9, "pos": "left:80px;top:300px;width:820px", "cls": "say", "cred": "AI Broadsheet presents", "html": "The machines learned to read." },
    { "t0": 8.2, "t1": 12.6, "pos": "left:80px;top:1380px;width:900px", "cls": "say", "html": "Then they learned to write." },
    { "t0": 15.4, "t1": 19.9, "pos": "left:80px;top:300px;width:900px", "cls": "say", "html": "Every story now has<br>a second author." },
    { "t0": 22.7, "t1": 27.3, "pos": "left:80px;top:300px;width:900px", "cls": "say", "html": "Somebody has to<br>read the machines." },
    { "t0": 30.0, "t1": 34.8, "pos": "left:80px;top:1460px;width:900px", "cls": "say", "cred": "Our first rule", "html": "Written from the reporting." },
    { "t0": 37.5, "t1": 41.9, "pos": "left:80px;top:300px;width:900px", "cls": "say", "cred": "Our second rule", "html": "Checked against the source." },
    { "t0": 44.6, "t1": 49.3, "pos": "left:80px;top:1380px;width:900px", "cls": "say", "cred": "And we tell you", "html": "When the voice<br>isn't human." },
